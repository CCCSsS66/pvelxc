[Unit]
Description=SillyTavern LLM frontend
Requires=sillytavern-bootstrap.service sillytavern-disable-ipv6.service
After=network-online.target sillytavern-bootstrap.service sillytavern-disable-ipv6.service
Wants=network-online.target

[Service]
Type=simple
User=sillytavern
Group=sillytavern
WorkingDirectory=/opt/sillytavern
Environment=NODE_ENV=production
EnvironmentFile=/etc/sillytavern/sillytavern.env
ExecStart=/usr/local/bin/node /opt/sillytavern/server.js --configPath /opt/sillytavern/config.yaml --dataRoot /var/lib/sillytavern --listen --listenAddressIPv4 0.0.0.0 --enableIPv4 true --enableIPv6 false --port 8000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
